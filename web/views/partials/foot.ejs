  radio.js / player.js 互为模块，所以 type="module"。app.js 那种全局共享的
  经典脚本用不了 import，但这两个文件只彼此依赖，不需要挂到 window 上。
%>
<script src="/static/radio.js?v=<%= assetVersion %>" type="module"></script>
<script src="/static/player.js?v=<%= assetVersion %>" type="module"></script>

<%
/* 品牌区：SVG 徽标（音符 + 下载箭头）+ 字标。
   - 用 SVG 而不是 ♪ 字符：字符依赖字体、基线不稳、各平台观感差异大。
   - 字标必须连续排版：early 版本给 .wordmark 加了 display:inline-flex，
     使 "amdl" 与 "-web" 成为两个 flex 项，中间凭空多了空隙，看起来像 "amdl -web"。
     这里把连字符并入前段（amdl- 正常色 + web 弱化），整体读作一个词。 */
%>
<a class="brand" href="/">
    <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="amdl-mark-g" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#9dbcff" />
                <stop offset="100%" stop-color="#4f74d8" />
            </linearGradient>
        </defs>
        <rect width="32" height="32" rx="9.5" fill="url(#amdl-mark-g)" />
        <!-- 音符：符头 + 符干 + 符尾 -->
        <circle cx="10.6" cy="20.7" r="3.7" fill="#0a0b10" />
        <path d="M13.9 20.1V8.9l6.9 2" fill="none" stroke="#0a0b10" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round" />
        <!-- 下载箭头 -->
        <path d="M22.2 13.6v5.1m0 0 2.3-2.3m-2.3 2.3-2.3-2.3" fill="none" stroke="#0a0b10"
              stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="wordmark">amdl-<span class="wm-tail">web</span></span>
</a>

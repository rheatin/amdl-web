<%- include("partials/head") %>

<section class="card">
    <h1>新建下载任务</h1>
    <p class="muted">粘贴 Apple Music 分享链接（song / album / playlist / artist），或先去<a href="/search">搜索</a>。</p>
    <form id="job-form" class="stack">
        <div class="row">
            <input name="url" id="job-url" placeholder="https://music.apple.com/…（粘贴后自动解析）" required>
            <button type="button" id="parse-btn" class="ghost">解析链接</button>
        </div>

        <div id="parse-result" class="parse-result muted">粘贴链接后会自动解析，确认可用编码再下载。</div>

        <div class="row" id="download-row" hidden>
            <select name="codec" id="job-codec">
                <option value="alac">ALAC 无损</option>
                <option value="atmos">Dolby Atmos</option>
                <option value="aac">AAC 有损</option>
            </select>
            <button type="submit" id="download-btn">开始下载</button>
        </div>

        <details class="opts">
            <summary>本次任务临时覆盖（可选）</summary>
            <label class="chk">
                <input type="checkbox" id="opts-override"> 对本次下载临时生效（不写入 config.yaml）
            </label>
            <fieldset id="opts-box" class="opt-grid">
                <label class="chk"><input type="checkbox" name="embedLrc" <%= opts.embedLrc ? "checked" : "" %>> 嵌入歌词到文件</label>
                <label class="chk"><input type="checkbox" name="saveLrcFile" <%= opts.saveLrcFile ? "checked" : "" %>> 另外保存 .lrc 文件</label>
                <label>歌词类型
                    <select name="lrcType">
                        <option value="lyrics" <%= opts.lrcType === "lyrics" ? "selected" : "" %>>逐行</option>
                        <option value="syllable-lyrics" <%= opts.lrcType === "syllable-lyrics" ? "selected" : "" %>>逐字（带时间轴）</option>
                    </select>
                </label>
                <label>附加内容
                    <select name="lrcExtra">
                        <option value="" <%= opts.lrcExtra === "" ? "selected" : "" %>>无</option>
                        <option value="translation" <%= opts.lrcExtra === "translation" ? "selected" : "" %>>翻译</option>
                        <option value="pronunciation" <%= opts.lrcExtra === "pronunciation" ? "selected" : "" %>>罗马音</option>
                    </select>
                </label>
                <label>歌词格式
                    <select name="lrcFormat">
                        <option value="lrc" <%= opts.lrcFormat === "lrc" ? "selected" : "" %>>lrc</option>
                        <option value="ttml" <%= opts.lrcFormat === "ttml" ? "selected" : "" %>>ttml</option>
                    </select>
                </label>
            </fieldset>
            <p class="muted small">
                默认<strong>不勾选</strong>：任务完全按引擎 <code>config.yaml</code> 执行。
                勾选后这一个任务会覆盖上面的几项，<strong>只影响本次</strong>，不改任何配置文件。
                上面的取值就是 <code>config.yaml</code> 当前的有效值，正在生效中。
            </p>
        </details>
    </form>
    <p id="job-form-msg" class="muted"></p>
</section>

<section class="grid">
    <div class="card">
        <h2>队列</h2>
        <p><span class="pill">进行中 <b><%= queue.running %></b></span> <span class="pill">等待 <b><%= queue.pending %></b></span></p>
        <p class="muted">并发：<%= config.concurrency %> · wrapper-lite：<code><%= config.liteServer %></code></p>
    </div>
    <div class="card">
        <h2>最近任务</h2>
        <% if (jobs.length === 0) { %>
            <div class="empty">还没有任务 —— 上面粘一个链接就能开始。</div>
        <% } else { %>
            <ul class="list">
            <% jobs.forEach(function (j) { %>
                <li>
                    <a href="/jobs?job=<%= j.id %>">#<%= j.id %></a>
                    <span class="badge <%= j.status %>"><%= j.status %></span>
                    <span class="muted"><%= j.codec %></span>
                    <span class="ellipsis"><%= j.url %></span>
                </li>
            <% }); %>
            </ul>
        <% } %>
    </div>
    <div class="card">
        <h2>最近入库</h2>
        <% if (tracks.length === 0) { %>
            <div class="empty">还没有文件 —— 下载完成后会在这里列出。</div>
        <% } else { %>
            <ul class="list">
            <% tracks.forEach(function (t) { %>
                <li><span class="ellipsis"><%= t.artist %> — <%= t.song %></span></li>
            <% }); %>
            </ul>
        <% } %>
    </div>
</section>

<%- include("partials/foot") %>

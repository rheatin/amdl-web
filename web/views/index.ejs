<%- include("partials/head") %>

<%#
  概览页。两条设计约束：
    * 搜索与"贴链接"是同一件事的两种入口，所以并排放在最上面；
    * 解释性文字（地区语义、自动匹配风险、歌词覆盖）全部降级为 hover 气泡，
      只留一个 ? 标记 —— 过去这些是常驻大段文字，占了页面最宽的位置。
%>
<section class="card accent">
    <div class="label">download pipeline</div>
    <h1>新建下载</h1>
    <div class="row">
        <form method="get" action="/search" class="row" style="flex:1 1 320px">
            <input name="q" placeholder="搜索歌名 / 专辑 / 艺人" aria-label="搜索 Apple Music">
            <label class="inline-field">商店
                <%- include("partials/region-select", {
                    name: "region", selected: "", inheritLabel: `默认（${defaultRegionName}）`
                }) %>
            </label>
            <button type="submit">搜索</button>
        </form>
        <button type="button" class="ghost" onclick="document.getElementById('job-url').focus()">粘贴链接</button>
    </div>

    <form id="job-form" class="stack" style="margin-top:var(--space-5)">
        <div class="row">
            <input name="url" id="job-url" placeholder="https://music.apple.com/…（粘贴后自动解析）" required>
            <button type="button" id="parse-btn" class="ghost">解析链接</button>
        </div>

        <div id="parse-result" class="parse-result muted">粘贴链接后会自动解析，确认可用编码再下载。</div>

        <%# 音质明细：位深 / 采样率 / Hi-Res / Dolby Atmos —— 由 app.js 在解析后填充 %>
        <div id="quality-panel" hidden></div>

        <div class="row" id="region-row">
            <label class="inline-field">元数据地区
                <%- include("partials/region-select", {
                    name: "region", id: "job-region", selected: "", inheritLabel: "跟随链接"
                }) %>
            </label>
            <label class="chk">
                <input type="checkbox" id="job-automatch" name="autoMatch">
                目标区没有时自动找等价记录
                <span class="warn">（有下错风险）</span>
                <span class="why right" tabindex="0">?
                    <span class="why-body">
                        <b>为什么需要它</b><br>
                        同一首歌在 Apple 目录里往往有多条记录（不同年代的再版、精选集、EP），
                        它们在目标区的标题才是当地人看到的写法。所以「目标区没有这条链接的记录」
                        并不等于「目标区没有这首歌」。<br><br>
                        <b>判定有多严</b><br>
                        会在目标区搜一次，只有<b>艺人名与时长都一致</b>（±1 秒）才改用搜到的那条记录；
                        任何一项对不上就<b>一律回退</b>到原链接。<b>不勾选则只回退，绝不替换。</b><br><br>
                        <b>风险</b><br>
                        同名不同版本很多（翻唱、现场版、TV size、instrumental、钢琴版…），
                        实测在同一个搜索结果里就撞见过同名翻唱。时长与艺人是目前最可靠的两个信号，
                        但仍不能保证 100% 正确 —— <b>换用后请到任务页确认落盘的曲目名与时长</b>，
                        确认无误再删旧的罗马音版本。<br><br>
                        自动匹配<b>只对单曲链接生效</b>；整张专辑/播放列表不做替换（换记录会改变任务规模）。
                    </span>
                </span>
            </label>
        </div>
        <%# 地区语义：解析前先给一句常驻解释（用户还没输入任何东西），
            解析成功后由 app.js 换成"请求什么区 → 实际什么区 + 回退原因"。
            为什么要一直挂在这里：它是这个表单最容易误解的一项。 %>
        <p id="region-note" class="parse-result muted small">地区决定<strong>元数据取自哪个目录</strong>（也就是文件名与内嵌标签的写法：日区多为日文原名，大陆区常见英文/罗马音）。音频本身是同一条记录。目标区没有这条记录时会<strong>自动回退</strong>到链接原本的地区。</p>

        <div class="row" id="download-row" hidden>
            <select name="codec" id="job-codec">
                <option value="alac">ALAC 无损</option>
                <option value="atmos">Dolby Atmos</option>
                <option value="aac">AAC 有损</option>
            </select>
            <button type="submit" id="download-btn">开始下载</button>
        </div>

        <details class="opts">
            <summary>本次任务临时覆盖（可选）</summary>
            <label class="chk">
                <input type="checkbox" id="opts-override"> 对本次下载临时生效（不写入 config.yaml）
            </label>
            <fieldset id="opts-box" class="opt-grid">
                <label class="chk"><input type="checkbox" name="embedLrc" <%= opts.embedLrc ? "checked" : "" %>> 嵌入歌词到文件</label>
                <label class="chk"><input type="checkbox" name="saveLrcFile" <%= opts.saveLrcFile ? "checked" : "" %>> 另外保存 .lrc 文件</label>
                <label>歌词类型
                    <select name="lrcType">
                        <option value="lyrics" <%= opts.lrcType === "lyrics" ? "selected" : "" %>>逐行</option>
                        <option value="syllable-lyrics" <%= opts.lrcType === "syllable-lyrics" ? "selected" : "" %>>逐字（带时间轴）</option>
                    </select>
                </label>
                    <select name="lrcExtra">
                        <option value="" <%= opts.lrcExtra === "" ? "selected" : "" %>>无</option>
                        <option value="translation" <%= opts.lrcExtra === "translation" ? "selected" : "" %>>翻译</option>
                        <option value="pronunciation" <%= opts.lrcExtra === "pronunciation" ? "selected" : "" %>>罗马音</option>
                    </select>
                </label>
                <label>歌词格式
                    <select name="lrcFormat">
                        <option value="lrc" <%= opts.lrcFormat === "lrc" ? "selected" : "" %>>lrc</option>
                        <option value="ttml" <%= opts.lrcFormat === "ttml" ? "selected" : "" %>>ttml</option>
                    </select>
                </label>
            </fieldset>
            <p class="muted small">
                默认<strong>不勾选</strong>：任务完全按引擎 <code>config.yaml</code> 执行。
                勾选后这一个任务会覆盖上面的几项，<strong>只影响本次</strong>，不改任何配置文件。
                上面的取值就是 <code>config.yaml</code> 当前的有效值，正在生效中。
            </p>
        </details>
    </form>
    <p id="job-form-msg" class="muted"></p>
</section>

<section class="grid">
    <div class="card">
        <h2 class="card-title">队列</h2>
        <p class="row">
            <span class="stat"><b><%= queue.running %></b><span>进行中</span></span>
            <span class="stat"><b><%= queue.pending %></b><span>等待</span></span>
        </p>
        <p class="muted small">并发 <%= config.concurrency %> · wrapper-lite <code><%= config.liteServer %></code></p>
    </div>
    <div class="card">
        <div class="head-row">
            <h2 class="card-title">最近任务</h2>
            <a class="muted small" href="/jobs">全部 →</a>
        </div>
        <% if (jobs.length === 0) { %>
            <div class="empty">还没有任务</div>
        <% } else { %>
            <ul class="list">
            <% jobs.forEach(function (j) { %>
                <li>
                    <span class="cover-mini<%= j.meta && j.meta.artwork ? "" : " no-art" %>">
                        <% if (j.meta && j.meta.artwork) { %>
                            <img src="<%= art(j.meta.artwork, 160) %>" alt="" loading="lazy" width="32" height="32">
                        <% } %>
                    </span>
                    <a href="/jobs?job=<%= j.id %>" class="grow ellipsis">#<%= j.id %> <%= j.meta ? j.meta.title : "" %></a>
                    <span class="badge <%= j.status %>" data-job-badge="<%= j.id %>"><%= statusText[j.status] %></span>
                </li>
            <% }); %>
            </ul>
        <% } %>
    </div>
    <div class="card">
        <div class="head-row">
            <h2 class="card-title">最近入库</h2>
            <a class="muted small" href="/library">全部 →</a>
        </div>
        <% if (tracks.length === 0) { %>
            <div class="empty">还没有文件</div>
        <% } else { %>
            <ul class="list">
            <% tracks.forEach(function (t) { %>
                <li>
                    <span class="cover-mini no-art" aria-hidden="true"></span>
                    <span class="grow ellipsis"><%= t.artist || "—" %> — <%= t.song %></span>
                    <% if (t.size) { %><span class="pill"><%= (t.size / 1048576).toFixed(0) %> MB</span><% } %>
                </li>
            <% }); %>
            </ul>
        <% } %>
    </div>
</section>

<%- include("partials/foot") %>

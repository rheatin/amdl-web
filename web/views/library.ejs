<%- include("partials/head") %>

<%#
  音乐库 —— 按专辑分组的封面墙。

  数据仍来自任务记录（store.allTracks），**不扫盘** —— 用户明确选了这一点。
  所以这里展示的是"任务报告落盘的曲目"，不是对 MUSIC_DIR 的实时盘点。

  为什么按专辑分组而不是一张长表格：音乐的最小有意义单位是专辑而不是单曲，
  而现在每条 Track 都带着 artist/album/artwork/size/durationMs ——
  分组所需的数据早就齐了，之前只是没被用起来。
  分组键直接用 `artist + album` 拼接：这两个字段本来就分别来自落盘目录的
  第 1、2 层目录，拼接后撞车的概率极低；而人为加分隔符反而会在
  "同名专辑、不同艺人" 时被合并 —— 那比分组键撞车更常见。
%>
<%
const GROUPS = new Map();
for (const t of tracks) {
    const artist = t.artist || "未知艺人";
    const album = t.album || "未知专辑";
    const key = `${artist}${album}`;
    if (!GROUPS.has(key)) {
        GROUPS.set(key, {
            artist, album, tracks: [], bytes: 0, ms: 0, artwork: "", jobIds: []
        });
    }
    const g = GROUPS.get(key);
    g.tracks.push(t);
    g.bytes += t.size || 0;
    g.ms += t.durationMs || 0;
    if (!g.artwork && t.artwork) g.artwork = t.artwork;
    if (g.jobIds.indexOf(t.jobId) < 0) g.jobIds.push(t.jobId);
}
/* 新的在前：最近下载的专辑排上面 */
const groups = [...GROUPS.values()].reverse();
const MINS = (ms) => (ms ? Math.floor(ms / 60000) + " 小时 " + Math.floor(((ms / 1000) % 60)) + " 分" : "");
const MB = (b) => (b ? (b / 1048576).toFixed(0) + " MB" : "—");

/*
 * 封面 URL 的两种来源（优先级由 store.allTracks 决定，见 store.ts 的注释）：
 *   · 以 / 开头 —— 磁盘上音频同目录的 cover.jpg（引擎下载时写的，历史任务也有），
 *     走 /api/cover 路由取用；那条路由做了落盘目录包含性校验，只暴露封面本身。
 *   · 其它 —— mzstatic 的模板字符串，按尺寸展开。
 */
const coverUrl = (tpl) => {
    if (typeof tpl !== "string" || !tpl) return "";
    // 以 / 开头的是**磁盘上的封面文件路径**（store.allTracks 给的），
    // 要走 /api/cover 路由 —— 那条路由做了落盘目录包含性校验，只暴露封面本身。
    if (tpl.startsWith("/")) return `/api/cover?path=${encodeURIComponent(tpl)}`;
    return art(tpl, 300);
};
%>
<section class="card">
    <div class="head-row">
        <h1 class="card-title">音乐库</h1>
        <span class="pill"><%= tracks.length %> 首 · <%= groups.length %> 张专辑</span>
    </div>
    <p class="muted small">
        落盘根目录 <code><%= musicDir %></code>
        <span class="why right" tabindex="0">?
            <span class="why-body">
                这一页列出的是<b>任务报告落盘的曲目</b>（来自任务记录），不是对目录的实时扫描：
                先于任务记录就存在的文件、以及手动放进目录的文件都不会出现在这里。
                引擎实际按编码写入 <code>paths.alac</code> / <code>paths.atmos</code> /
                <code>paths.aac</code> / <code>paths.mv</code> 四个子目录，各自可在
                <a href="/settings">配置页</a>核对。
            </span>
        </span>
    </p>
</section>

<% if (groups.length === 0) { %>
    <section class="card"><div class="empty">还没有文件。下载完成后这里会列出引擎报告的曲目。</div></section>
<% } else { %>
<%#
    grid 而不是「一张专辑一行」。

    之前每张专辑占满整行（120px 封面 + 曲目纵向铺开），83 张专辑要滚很久 ——
    封面两侧全是留白。改成 auto-fill 网格后一屏能看十几张，
    而"这张专辑下全了没有"靠悬停/聚焦展开曲目列表来核对。
%>
<div class="album-grid">
    <% groups.forEach(function (g) { %>
        <article class="album" tabindex="0">
            <div class="album-art<%= g.artwork ? "" : " no-art" %>">
                <% if (g.artwork) { %>
                    <img src="<%= coverUrl(g.artwork) %>" alt="<%= g.album %> 封面" loading="lazy" width="300" height="300">
                <% } %>
                <%# 首数角标：不展开也知道这张专辑有几首 %>
                <span class="album-count"><%= g.tracks.length %></span>
                <%#
                    曲目列表从**封面内部**自下而上推出，和搜索结果的下载面板同一套手法。

                    之前它是贴在整张卡片底部的绝对定位块，于是盖住了标题下方的
                    艺人名和芯片 —— 截图里那个"半透明框里一团黑字"就是它。
                    放进 .album-art 之后：封面有 overflow:hidden，面板被裁在图片内，
                    永远压不到卡片里的文字。
                %>
                <div class="album-panel">
                    <ul class="album-tracks">
                        <% g.tracks.forEach(function (t) { %>
                            <li>
                                <span class="ellipsis"><%= t.song %></span>
                                <% if (t.durationMs) { %><span class="num"><%= Math.floor(t.durationMs / 60000) %>:<%= String(Math.floor((t.durationMs / 1000) % 60)).padStart(2, "0") %></span><% } %>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            </div>
            <div class="album-info">
                <h2 class="album-title ellipsis" title="<%= g.album %>"><%= g.album %></h2>
                <div class="album-artist ellipsis" title="<%= g.artist %>"><%= g.artist %></div>
                <div class="album-facts">
                    <span class="q-chip"><%= MB(g.bytes) %></span>
                    <a class="q-chip" href="/?job=<%= g.jobIds[0] %>" title="下载这个任务">#<%= g.jobIds[0] %></a>
                </div>
            </div>
        </article>
    <% }) %>
</div>
<% } %>

<%- include("partials/foot") %>

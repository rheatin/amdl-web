<%- include("partials/head") %>

<section class="card">
    <h1>音乐库</h1>
    <p class="muted">落盘目录：<code><%= musicDir %></code> · 共 <b><%= tracks.length %></b> 首</p>
    <% if (tracks.length === 0) { %>
        <div class="empty">还没有文件。下载完成后这里会列出引擎报告的曲目。</div>
    <% } else { %>
        <table class="table">
            <thead><tr><th>艺人</th><th>专辑</th><th>曲目</th><th>路径</th><th>任务</th></tr></thead>
            <tbody>
            <% tracks.forEach(function (t) { %>
                <tr>
                    <td><%= t.artist %></td>
                    <td><%= t.album %></td>
                    <td><%= t.song %></td>
                    <td class="path"><code><%= t.path %></code></td>
                    <td><a href="/jobs?job=<%= t.jobId %>">#<%= t.jobId %></a></td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    <% } %>
</section>

<%- include("partials/foot") %>

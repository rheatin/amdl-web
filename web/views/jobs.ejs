<%- include("partials/head") %>

<section class="grid two">
    <div class="card">
        <h2>任务列表</h2>
        <p class="muted">进行中 <b><%= queue.running %></b> · 等待 <b><%= queue.pending %></b></p>
        <% if (jobs.length === 0) { %>
            <p class="muted">还没有任务，去<a href="/">新建一个</a>。</p>
        <% } else { %>
            <ul class="list">
            <% jobs.forEach(function (j) { %>
                <li class="<%= (selected && selected.id === j.id) ? 'sel' : '' %>">
                    <a href="/jobs?job=<%= j.id %>">#<%= j.id %></a>
                    <span class="badge <%= j.status %>" data-job-badge="<%= j.id %>"><%= j.status %></span>
                    <span class="muted"><%= j.codec %></span>
                    <% if (j.region && j.region.requested) { %>
                        <span class="muted small">地区 <%= j.region.requested %><%= j.region.fallback ? "→" + (j.region.effective || "?") : "" %></span>
                    <% } %>
                    <% if (j.region && j.region.fallback) { %><span class="warn small" title="<%= j.region.note %>">已回退</span><% } %>
                    <span class="ellipsis"><%= j.url %></span>
                </li>
            <% }); %>
            </ul>
        <% } %>
    </div>

    <div class="card">
        <% if (!selected) { %>
            <h2>任务详情</h2>
            <p class="muted">左侧选一个任务。</p>
        <% } else { %>
            <h2>任务 #<%= selected.id %> <span class="badge <%= selected.status %>" id="job-status"><%= selected.status %></span></h2>
            <p class="muted ellipsis"><%= selected.url %></p>
            <p class="muted">
                codec <code><%= selected.codec %></code>
                <% if (selected.startedAt) { %> · 开始 <%= new Date(selected.startedAt).toLocaleString() %><% } %>
                <% if (selected.finishedAt) { %> · 结束 <%= new Date(selected.finishedAt).toLocaleString() %><% } %>
            </p>
            <% if (selected.error) { %><p class="<%= selected.status === 'partial' ? 'warn' : 'err' %>" id="job-error"><%= selected.error %></p><% } else { %><p class="err" id="job-error" hidden></p><% } %>
            <p class="row">
                <button class="ghost" type="button" data-retry="<%= selected.id %>">重试这个任务</button>
                <span class="muted small">已下载的曲目会被引擎跳过，只补失败的那几首；地区沿用本任务的记录，不重新探测</span>
            </p>
            <% if (selected.region) { %>
                <%
                const r = selected.region;
                const reasonLabels = {
                    none: "跟随链接",
                    same_region: "与链接一致",
                    ok: "目标区生效",
                    matched: "已自动匹配",
                    not_in_target: "目标区没有 → 已回退",
                    probe_failed: "探测失败 → 已回退",
                    unprobed: "未预检（按目标区执行）",
                    rewrite_failed: "改写失败 → 原链接"
                };
                const bad = r.fallback || r.reason === "probe_failed" || r.reason === "rewrite_failed";
                %>
                <h3>元数据地区</h3>
                <p class="muted small">
                    请求 <code><%= r.requested || "跟随链接" %></code>
                    → 实际 <code><%= r.effective || "-" %></code>
                    <span class="badge <%= bad ? 'partial' : 'done' %>"><%= reasonLabels[r.reason] || r.reason %></span>
                </p>
                <p class="<%= bad ? 'warn' : 'muted' %> small"><%= r.note %></p>
                <% if (r.match) { %>
                    <p class="muted small">
                        匹配到的记录：<code><%= r.match.id %></code>
                        <%= r.match.name %> — <%= r.match.artistName %><%= r.match.albumName ? `（${r.match.albumName}）` : "" %>
                    </p>
                <% } %>
                <% if (r.originalUrl && r.originalUrl !== selected.url) { %>
                    <p class="muted small">你贴的原始链接：<span class="ellipsis"><%= r.originalUrl %></span></p>
                <% } %>
            <% } %>
            <h3>本次覆盖</h3>
            <% const overrides = Object.keys(selected.options || {}); %>
            <% if (overrides.length === 0) { %>
                <p class="muted small">无 —— 完全按 <code>config.yaml</code> 的值执行（只记录显式覆盖，不落盘）。</p>
            <% } else { %>
                <% const optLabels = { embedLrc: "嵌入歌词", saveLrcFile: "另存 .lrc", lrcType: "歌词类型", lrcExtra: "附加", lrcFormat: "格式" }; %>
                <p class="muted small">仅本任务：
                    <% overrides.forEach(function (k, i) { %><%= i ? " · " : "" %><%= optLabels[k] || k %> <code><%= String(selected.options[k]) %></code><% }); %>
                </p>
            <% } %>
            <h3>引擎输出</h3>
            <pre id="console" data-job="<%= selected.id %>"></pre>
            <p class="muted"><span id="track-count"><%= selected.tracks.length %></span> 首已落盘</p>
        <% } %>
    </div>
</section>

<%- include("partials/foot") %>

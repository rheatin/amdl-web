<%- include("partials/head") %>

<section class="card">
    <h1>配置</h1>
    <p class="muted">
        下面的下载语义<strong>直接写回 <code><%= engineFile %></code> 本身</strong>，写完立即生效，
        不需要重启容器 —— 写的是同一个文件，不存在「两份配置」。
        每次写入前会自动留一份 <code>config.yaml.bak</code>。
    </p>
    <table class="table">
        <tbody>
            <tr>
                <th>这里能改</th>
                <td>音质上限 / 歌词 / 地区与语言
                    <span class="muted small">（写进 <code>config.yaml</code>）</span></td>
            </tr>
            <tr>
                <th>这里不能改</th>
                <td>端口 / 目录 / 权限 / 时区 / 代理 / 并发 —— 在 <code>.env</code> 里
                    <span class="muted small">（改了要重建容器，网页给个假开关只会误导）</span></td>
            </tr>
            <tr>
                <th>Apple 凭据</th>
                <td>不提供网页入口
                    <span class="muted small">（<code>media-user-token</code> 属于账号侧，请直接编辑文件）</span></td>
            </tr>
            <tr>
                <th>一次性的</th>
                <td>新建任务页的<strong>「本次任务临时覆盖」</strong>
                    <span class="muted small">（只影响那一次下载，不落盘）</span></td>
            </tr>
        </tbody>
    </table>
</section>

<section class="card" id="engine-edit">
    <h2 class="card-title">下载设置</h2>
    <p class="muted small">
        只列出<strong>能安全修改</strong>的项。文件里其它键（凭据、落盘路径、代理等）原样保留，
        界面不会碰它们。
    </p>
    <% if (!fields || fields.length === 0) { %>
        <div class="empty">读不到 <code><%= engineFile %></code>，无法编辑。</div>
    <% } else { %>
    <form id="engine-form">
        <%
        /* 分组只影响排版；顺序按实际使用频率排（音质最常改）。 */
        const GROUPS = [
            { title: "音质上限", hint: "指引擎实际取到的上限，不是 Apple 提供什么", names: ["alacMax", "atmosMax", "aacType"] },
            { title: "MV", hint: "音乐视频由链接决定，这里只是画质上限", names: ["mvMax", "mvAudioType"] },
            { title: "歌词", hint: "任务页仍可临时覆盖", names: ["lyricsEmbed", "lyricsSaveFile", "lyricsType", "lyricsExtra", "lyricsFormat"] },
            { title: "地区与语言", hint: "影响搜索、编码探测与元数据语言", names: ["storefront", "language"] }
        ];
        const LABEL = {
            alacMax: "ALAC 采样率上限（Hz）",
            atmosMax: "Atmos 码率上限（kbps）",
            aacType: "AAC 流配置",
            mvMax: "MV 纵向分辨率上限",
            mvAudioType: "MV 音轨",
            lyricsEmbed: "把歌词写进标签",
            lyricsSaveFile: "另存 .lrc 文件",
            lyricsType: "歌词粒度",
            lyricsExtra: "附加内容",
            lyricsFormat: "歌词格式",
            storefront: "店铺地区",
            language: "元数据语言"
        };
        const UNIT = { alacMax: "Hz", atmosMax: "kbps", mvMax: "p" };
        const OPTION_TEXT = {
            "true": "开", "false": "关",
            "lyrics": "逐行", "syllable-lyrics": "逐字",
            "": "无", "translation": "翻译", "pronunciation": "罗马音",
            "lrc": "LRC", "ttml": "TTML",
            "aac": "aac", "aac-lc": "aac-lc", "aac-binaural": "aac-binaural", "aac-downmix": "aac-downmix",
            "atmos": "atmos", "ac3": "ac3"
        };
        const byName = {};
        fields.forEach(function (f) { byName[f.name] = f; });
        %>
        <% GROUPS.forEach(function (g) { %>
            <fieldset class="cfg-group">
                <legend><%= g.title %></legend>
                <p class="cfg-hint"><%= g.hint %></p>
                <% g.names.forEach(function (name) {
                       const f = byName[name];
                       if (!f) return; %>
                    <div class="cfg-row" data-name="<%= name %>">
                        <label for="cfg-<%= name %>"><%= LABEL[name] || name %></label>
                        <div class="cfg-input">
                            <% if (f.bool) { %>
                                <select id="cfg-<%= name %>" name="<%= name %>">
                                    <option value="true"<%= f.value === "true" ? " selected" : "" %>>开</option>
                                    <option value="false"<%= f.value === "false" ? " selected" : "" %>>关</option>
                                </select>
                            <% } else if (f.allowed.length > 0) { %>
                                <select id="cfg-<%= name %>" name="<%= name %>">
                                    <% f.allowed.forEach(function (v) { %>
                                        <option value="<%= v %>"<%= f.value === v ? " selected" : "" %>><%= OPTION_TEXT[v] || v %></option>
                                    <% }); %>
                                </select>
                            <% } else { %>
                                <%#
                                  不加 pattern：HTML5 的 pattern 是"整值匹配"，写 [0-9]*
                                  在 Chrome 上会让这三个本来合法的数字框全部校验失败，
                                  表单直接提交不出去（按钮像坏了）。数值校验由服务端做，
                                  它会回一条能看懂的错误；这里 inputmode 只负责唤起数字键盘。
                                %>
                                <input id="cfg-<%= name %>" name="<%= name %>"
                                       value="<%= f.value %>"
                                       <%= f.numeric ? 'inputmode="numeric"' : "" %>
                                       placeholder="<%= f.value === "" ? "未设置（引擎用默认值）" : "" %>">
                                <% if (UNIT[name]) { %><span class="unit"><%= UNIT[name] %></span><% } %>
                            <% } %>
                            <code class="cfg-path" title="实际写入的键"><%= f.path %></code>
                        </div>
                    </div>
                <% }); %>
            </fieldset>
        <% }); %>
        <div class="row cfg-actions">
            <button type="submit" class="primary">保存并立即生效</button>
            <button type="button" class="ghost" id="engine-revert">放弃修改</button>
            <span id="engine-msg" class="muted small" role="status"></span>
        </div>
    </form>
    <% } %>
</section>

<section class="card">
    <h2>运行信息（来自 <code>.env</code>）</h2>
    <table class="table">
        <tbody>
            <tr><th>wrapper-lite 后端</th><td><code><%= config.liteServer %></code>（<code>LITE_SERVER</code>）</td></tr>
            <tr><th>ripper 可执行</th><td><code><%= config.engineBin %></code>（<code>ENGINE_BIN</code>）</td></tr>
            <tr><th>ripper 工作目录</th><td><code><%= config.engineDir %></code>（<code>ENGINE_DIR</code>）</td></tr>
            <tr><th>音乐目录</th><td><code><%= config.musicDir %></code>（<code>MUSIC_DIR</code>）</td></tr>
            <tr><th>状态目录</th><td><code><%= config.dataDir %></code>（<code>DATA_DIR</code>）</td></tr>
            <tr><th>wrapper 数据目录</th><td><code><%= config.wrapperDataDir %></code>（<code>WRAPPER_DATA_DIR</code>，2FA 验证码写在这里）</td></tr>
            <tr><th>进程属主 / 属组</th><td><code><%= config.puid %>:<%= config.pgid %></code>（<code>PUID</code>/<code>PGID</code>，须与 compose 的 <code>user:</code> 及宿主目录属主一致）</td></tr>
            <tr><th>任务并发</th><td><%= config.concurrency %>（<code>JOB_CONCURRENCY</code>）</td></tr>
            <tr><th>单任务超时 / 日志行数</th><td><%= config.jobTimeoutSec %> 秒 / <%= config.logLines %> 行（<code>JOB_TIMEOUT_SEC</code> / <code>JOB_LOG_LINES</code>）</td></tr>
            <tr><th>下载后文件权限</th><td>
                <% if (config.fileMode === null) { %>
                    <code>keep</code> —— 保持引擎默认（600），媒体服务器可能读不到
                <% } else { %>
                    <code><%= config.fileMode.toString(8) %></code>（<code>FILE_MODE</code>）
                <% } %>
            </td></tr>
            <tr><th>会话有效期</th><td><%= config.sessionDays %> 天（<code>SESSION_DAYS</code>）</td></tr>
            <tr><th>信任反向代理</th><td><%= config.trustProxy ? "是（TRUST_PROXY）" : "否（TRUST_PROXY 未开）" %></td></tr>
            <tr><th>出网代理</th><td>
                <% var px = config.httpsProxy || config.httpProxy; %>
                <%= px ? px : "直连（HTTP_PROXY / HTTPS_PROXY 未设置）" %>
            </td></tr>
            <tr><th>时区</th><td><code><%= process.env.TZ || "（未设置 TZ，容器默认 UTC）" %></code></td></tr>
            <tr><th>队列</th><td>进行中 <%= queue.running %> · 等待 <%= queue.pending %></td></tr>
        </tbody>
    </table>
</section>

<section class="card">
    <h2 class="card-title">音质与画质上限（来自 <code>config.yaml</code>）</h2>
    <p class="muted small">
        搜索结果上的 Hi-Res / Dolby Atmos 标记说的是 <b>Apple 提供什么</b>；
        这一栏说的是 <b>引擎实际上限</b>。两者不一致时，界面会在卡片上标 <span class="q-chip capped">⚠</span>，
        因为落盘的是引擎取的那一档。
        <span class="why right" tabindex="0">?
            <span class="why-body">
                这三个键的单位不同，不能互相换算：<br>
                · <code>alac-max</code> = ALAC <b>采样率</b>上限（Hz），192000 / 96000 / 48000 / 44100<br>
                · <code>atmos-max</code> = Atmos <b>码率</b>上限（kbps），2768 / 2448<br>
                · <code>mv-max</code> = MV <b>纵向分辨率</b>上限，如 2160 / 1080 / 720<br><br>
                没写就是没写 —— 这里显示「未设置（引擎用自身默认值）」，而不是替它猜一个值。
            </span>
        </span>
    </p>
    <%# 注意：这里必须用**逐行判断 + 普通输出标签**，不能把整段 HTML 拼进一个模板字符串
        再用输出标签输出 —— EJS 会把其中的尖括号转义成实体，页面上就会出现
        字面量的 <code>48000</code>。 %>
    <dl class="kv">
        <dt>ALAC 采样率上限</dt>
        <dd>
            <% if (ceilings && ceilings.alacMaxHz) { %><code><%= ceilings.alacMaxHz %></code> Hz（alac-max）<% } else { %><span class="muted">未设置（引擎用自身默认值）</span><% } %>
        </dd>
        <dt>Dolby Atmos 码率上限</dt>
        <dd>
            <% if (ceilings && ceilings.atmosMaxKbps) { %><code><%= ceilings.atmosMaxKbps %></code> kbps（atmos-max）<% } else { %><span class="muted">未设置</span><% } %>
        </dd>
        <dt>MV 分辨率 / 音轨</dt>
        <dd>
            <% if (ceilings && ceilings.mvMax) { %><code><%= ceilings.mvMax %>p</code><% } else { %><span class="muted">未设置</span><% } %>
            <% if (ceilings && ceilings.mvAudioType) { %> · 音轨 <code><%= ceilings.mvAudioType %></code><% } %>
        </dd>
        <dt>AAC 流配置</dt>
        <dd>
            <% if (ceilings && ceilings.aacType) { %><code><%= ceilings.aacType %></code><% } else { %><span class="muted">未设置</span><% } %>
        </dd>
    </dl>
</section>

<section class="card">
    <h2>地区与语言（跟随 <code>config.yaml</code>）</h2>
    <p class="muted">
        <code>.env</code> 里的 <code>STOREFRONT</code> / <code>LANGUAGE</code> 只作兜底：
        只要 <code>config.yaml</code> 写了这两个键，就以文件为准（同一个地方配地区，搜索、编码探测、下载元数据一起变）。
    </p>
    <table class="table">
        <tbody>
            <tr><th>生效的店铺地区</th><td><code><%= storefront %></code></td></tr>
            <tr><th>生效的元数据语言</th><td><code><%= language %></code></td></tr>
        </tbody>
    </table>
</section>

<section class="card">
    <h2>引擎配置 <code>config.yaml</code>（凭据已打码）</h2>
    <% if (engineText === null) { %>
        <div class="empty">
            读不到 <code><%= engineFile %></code>。<br>
            常见原因：宿主机还没创建 <code>config.yaml</code>（compose 的 bind mount 会把缺失的目标建成目录）。
            修复：<code>cp config.example.yaml config.yaml</code> 填好后再 <code>docker compose up -d</code>。
        </div>
    <% } else { %>
        <p class="muted small">
            共 <b><%= engineKeys.length %></b> 个生效键。每个任务的私有配置都由这份文件复制而来，
            只额外写入 <code>lite-server</code>、<code>exit-on-error</code> 和你在任务页勾选的临时覆盖项。
            <button type="button" class="ghost" data-copy="#engine-config">复制全文</button>
        </p>
        <dl class="kv">
            <% secrets.forEach(function (s) { %>
                <dt><code><%= s.key %></code></dt>
                <%# 这里必须用不转义的输出标签：注入的是下面这两个固定串，用转义标签会把标记本身当文本显示 %>
                <dd><%- s.set ? '<span class="badge done">已配置</span>' : '<span class="badge failed">未配置</span>' %></dd>
            <% }); %>
        </dl>
        <pre class="code" id="engine-config"><%= engineText %></pre>
        <p class="muted small">
            <code>media-user-token</code> 用于歌词 / 电台；留空则只能下载公开内容。
            <code>authorization-token</code> 留空时引擎会自行抓取 dev token（失败时先看容器能否出网）。
            本服务<strong>不保存、不代持</strong>你的 Apple 账号口令 —— 账号登录由 wrapper-lite 负责。
        </p>
    <% } %>
</section>

<section class="card">
    <h2>提交 Apple 2FA 验证码</h2>
    <p class="muted">
        Apple ID 登录与 2FA 由 <b>wrapper-lite</b> 承担。首次登录时若 Apple 要求验证码，
        wrapper-lite 会轮询 <code>&lt;base-dir&gt;/2fa.txt</code>（源码 <code>lite/auth.cpp</code>），
        在这里填即可 —— 无需登录宿主机改文件。
    </p>
    <form id="tfa-form" class="row">
        <input name="code" inputmode="numeric" autocomplete="one-time-code" placeholder="6 位验证码" required>
        <button type="submit">提交验证码</button>
    </form>
    <p id="tfa-msg" class="muted"></p>
    <p class="muted">
        另一种方式：启动 wrapper-lite 时用 <code>--login user:pass</code> 让它先登录一次，
        会话会缓存进 wrapper 数据目录，之后口令可以不再提供。
    </p>
</section>

<%# settings.js 只在本页加载：配置表单与 2FA 提交都在这里；
    app.js 保持跨页面通用（请求封装 + 操作委托 + 提示）。 %>
<script src="/static/settings.js?v=<%= assetVersion %>" defer></script>

<%- include("partials/foot") %>

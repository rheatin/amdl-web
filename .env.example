# =============================================================================
# amdl-web 部署配置（.env）
#
# 分层约定 —— 本文件只放「与宿主机/部署相关」的东西：
#   下载语义（音质 / 歌词 / 命名 / 转码 / 地区 / Apple 凭据）→ config.yaml
#   随手下一次（本次任务的歌词覆盖等）                        → 网页「新建下载」页
# 复制模板：cp .env.example .env      改完：docker compose up -d
# 权限建议：chmod 600 .env           （里面有站点管理员口令与会话密钥）
# =============================================================================

# ── 1. 站点管理员账号（你登录浏览器里的 amdl-web 用）──────────────────────────
# 两个都留空 → 首次打开 http://<NAS>:2000/login 时在网页里创建（推荐）
ADMIN_USER=
ADMIN_PASSWORD=
# 会话签名密钥：留空会自动生成并持久化到 data/web/session.secret
SESSION_SECRET=
# 登录状态保留天数
SESSION_DAYS=30

# ── 2. Apple 账号（仅 wrapper-lite 首次登录需要）──────────────────────────────
# 登录成功后会话缓存在 data/wrapper/，之后可以把这两行清空 —— 网页不保存、不代持账号口令。
# 若 Apple 要求 2FA：容器日志会提示，60 秒内到网页「配置」页提交 6 位验证码
# （网页会写入 data/wrapper/2fa.txt，wrapper-lite 轮询读取）。
USERNAME=
PASSWORD=

# ── 3. 路径（NAS 上的绝对路径）───────────────────────────────────────────────
# 音乐落盘目录；建议用独立音乐目录，便于媒体库统一索引
MUSIC_DIR=./music
# 例：MUSIC_DIR=/share/NAS/Downloads/Music
# 例：MUSIC_DIR=/mnt/media/Music          # 直接进媒体库给 jellyfin/navidrome 索引

# ── 4. 进程身份与权限 ────────────────────────────────────────────────────────
# 注意：容器进程身份由 compose 的 user: 决定（默认 1000:100）。
# PUID/PGID 只是把「期望值」暴露给网页自检显示；改这里不会改变进程身份。
# 若下载报 Permission denied：确认上面的 MUSIC_DIR 目录属主 = 这里的 PUID:PGID。
PUID=1000
PGID=100

# 下载完成后给音频文件（及同目录封面/歌词）设置的权限，八进制。
# 默认 666，与媒体库惯例一致 → navidrome/jellyfin 无论以哪个 uid 运行都能读到。
# 设为 keep 表示不改动引擎默认的 600。
FILE_MODE=666

# ── 5. 网页端口与绑定 ────────────────────────────────────────────────────────
# 0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机（配合反向代理时用）
WEB_BIND=0.0.0.0
WEB_PORT=2000
# 放在反向代理（Nginx/HAProxy/NAS 自带反代）后面时置 true，
# 才会信任 X-Forwarded-For / X-Forwarded-Proto（真实 IP、https 判断）
TRUST_PROXY=false

# ── 6. 时区 ─────────────────────────────────────────────────────────────────
# 影响日志时间戳与下载文件的 mtime。例：Asia/Shanghai
TZ=Asia/Shanghai

# ── 7. 出网代理（可选）──────────────────────────────────────────────────────
# 引擎下载媒体流走 Go 的 http.ProxyFromEnvironment，即下面这两个变量。
# 与 config.yaml 里的 proxy 不同：那个作用于「引擎 → amp-api」的元数据请求。
# 留空 = 直连。格式：http://host:port 或 socks5://host:port
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# ── 8. 任务与日志（一般不用改）───────────────────────────────────────────────
# 并发固定为 1：Apple 会按 IP 限流，且 wrapper-lite 不宜并发解密
JOB_CONCURRENCY=1
# 单任务超时（秒）
JOB_TIMEOUT_SEC=7200
# 每个任务保留多少行引擎输出
JOB_LOG_LINES=2000

# ── 9. 地区 / 语言（兜底，可选）──────────────────────────────────────────────
# 以 config.yaml 的 storefront / language 为准；只有那里没写时才用这里的值。
# 保持注释状态即可，避免出现「两份配置互相覆盖」。
# STOREFRONT=cn
# LANGUAGE=zh-Hans-CN

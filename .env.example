# =============================================================================
# amdl-web 配置 —— 私密信息集中在这里（权限 600，切勿提交到 git）
# 复制模板：cp .env.example .env     修改后：docker compose up -d
# =============================================================================

# ── 1. Apple Music 账号（wrapper-lite 解密用）─────────────────────────────────
# 只需成功登录一次：登录后会话会缓存进 data/wrapper/mpl_db，之后可以把这两行留空。
# 若 Apple 要求 2FA：容器日志会提示 "Enter your 2FA code into /data/2fa.txt"，
# 请在 60 秒内到网页「设置」页提交 6 位验证码（前端会写入 data/wrapper/2fa.txt）。
USERNAME=
PASSWORD=

# ── 2. 站点管理员账号（你登录浏览器里的 amdl-web 用）──────────────────────────
# 留空则首次打开 http://<NAS>:2000/login 时在网页里创建
ADMIN_USER=
ADMIN_PASSWORD=
# 会话签名密钥：留空会自动生成并持久化到 data/web/session.secret
SESSION_SECRET=

# ── 3. 音乐落盘目录（NAS 上的绝对路径）───────────────────────────────────────
# 默认：独立音乐目录（与 Download Station 的下载区同级，便于统一管理）
MUSIC_DIR=./music
# 其它可选：
# MUSIC_DIR=/mnt/user/Music          # 独立音乐目录（示例）
# MUSIC_DIR=/mnt/media/Music         # 直接进媒体库供 jellyfin/navidrome 索引（示例）

# ── 4. 目录搜索 / 元数据地区（不需要 Apple 账号；只影响搜索结果与元数据语言）──
STOREFRONT=us
LANGUAGE=en-US

# ── 5. 网页端口与绑定 ────────────────────────────────────────────────────────
# 0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机（配合反向代理时用）
WEB_BIND=0.0.0.0
WEB_PORT=2000

# ── 6. 任务与日志（一般不用改）───────────────────────────────────────────────
# 并发固定为 1：Apple 会按 IP 限流，且 wrapper-lite 不宜并发解密
JOB_CONCURRENCY=1
# 单任务超时（秒）
JOB_TIMEOUT_SEC=7200
# 每个任务保留多少行引擎输出
JOB_LOG_LINES=2000

# 下载完成后给音频文件（及同目录封面/歌词）设置的权限，八进制。
# 默认 666，与媒体库惯例一致 → navidrome/jellyfin 无论以哪个 uid 运行都能读到。
# 设为 keep 表示不改动引擎默认的 600。
FILE_MODE=666
